<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginTop="@dimen/card_margin_vertical"
    android:layout_marginBottom="@dimen/card_margin_vertical"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white_background"
    app:strokeColor="@color/light_grey_border"
    app:strokeWidth="@dimen/card_border_width"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/card_elevation"
    android:padding="@dimen/spacing_card_padding_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_size_heading"
                android:textColor="@color/textPrimary"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="8dp"/>

            <FrameLayout
                android:id="@+id/frame_new_flag"
                android:layout_width="80dp"
                android:layout_height="40dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_new_flag"
                    android:rotation="180" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="    NEW"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="italic"/>

            </FrameLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/textSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"/>

        <!-- Metadata Row: Date, Time, Location -->
        <LinearLayout
            android:id="@+id/layout_metadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <!-- Metadata items will be added programmatically -->
        </LinearLayout>

        <!-- Status Tags Row -->
        <LinearLayout
            android:id="@+id/layout_status_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <!-- Status tags will be added programmatically -->
        </LinearLayout>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_join"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_height_medium"
            android:text="@string/join_waitlist"
            android:textSize="@dimen/text_size_status"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/success_green"
            app:cornerRadius="@dimen/radius_button"
            android:visibility="visible"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_event"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_height_medium"
            android:text="@string/view_event"
            android:textSize="@dimen/text_size_status"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/primary_purple"
            app:cornerRadius="@dimen/radius_button"
            android:visibility="gone"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>