<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_outer">

        <!-- Page Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/create_event_title"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/create_event_subtitle"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/textSecondary" />

        <!-- Main Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white_background"
            app:cardElevation="@dimen/card_elevation"
            app:strokeColor="@color/light_grey_border"
            app:strokeWidth="@dimen/card_border_width"
            app:cardCornerRadius="@dimen/radius_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_card_padding_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_event_card_title"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/colorBlack"/>

                <!-- Event Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_vertical"
                    android:text="@string/create_event_name_label"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    android:textColor="@color/textSecondary"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_name_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:boxCornerRadiusTopStart="@dimen/radius_input"
                    app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input"
                    app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/light_grey_border"
                    app:hintEnabled="true"
                    app:hintTextColor="@color/textHint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_event_name_hint"
                        android:inputType="text"
                        android:padding="16dp"
                        android:textSize="@dimen/text_size_body"
                        android:textColorHint="@color/textHint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Category (New Field) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Category"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_category_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Sports, Music, Education"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_event_description_label"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_description_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_event_description_hint"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:gravity="top"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Event Dates Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_start_date_label"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_start_date_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_calendar_today">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_start_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="yyyy-mm-dd"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_end_date_label"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_end_date_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_calendar_today">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_end_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="yyyy-mm-dd"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Registration Dates Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_reg_start_date_label"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_reg_start_date_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_calendar_today">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_reg_start_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="yyyy-mm-dd"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_event_reg_end_date_label"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"/>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/input_reg_end_date_layout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:endIconMode="custom"
                            app:endIconDrawable="@drawable/ic_calendar_today">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_reg_end_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="yyyy-mm-dd"
                                android:focusable="false"
                                android:clickable="true"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Capacity -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_event_capacity_label"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_capacity_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_capacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g., 20"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_event_price_label"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_price_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="$ 20"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Waiting List Limit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/create_event_waiting_list_label"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_waiting_list_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_waiting_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/create_event_waiting_list_hint"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location (Optional) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Event Location (Optional)"
                    android:textStyle="bold"
                    android:textColor="@color/colorBlack"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_location_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g., 123 Cranberry Blvd..."
                            android:inputType="textPostalAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_locate"
                        style="@style/Widget.QuantiAgents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:text="Locate"
                        android:layout_marginTop="4dp"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#333333"/>
                </LinearLayout>

                <!-- Geolocation Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F5F5F5"
                    android:padding="12dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/create_event_geolocation_label"
                            android:textStyle="bold"
                            android:textColor="@color/colorBlack"/>
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switch_geolocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/create_event_geolocation_description"
                        android:textSize="10sp"
                        android:textColor="@color/colorOnSurfaceVariant"/>
                    <!-- Dummy visual for range -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:enabled="false">
                        <com.google.android.material.textfield.TextInputEditText
                            android:text="e.g., 20                                                                      Km"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="0dp"
                            android:textSize="12sp"
                            android:enabled="false"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Poster Upload Block - 200dp Square -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_vertical"
                    android:text="Poster Upload"
                    android:textSize="@dimen/text_size_caption"
                    android:textStyle="bold"
                    android:textColor="@color/textSecondary"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_poster_upload"
                    android:layout_width="@dimen/size_poster_upload"
                    android:layout_height="@dimen/size_poster_upload"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="center_horizontal"
                    app:cardBackgroundColor="@color/background_grey"
                    app:strokeColor="@color/light_grey_border"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="@dimen/radius_card"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/image_poster_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/icon_upload"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@android:drawable/ic_menu_upload"
                            app:tint="@color/textHint"
                            android:visibility="visible" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Upload Poster"
                            android:textSize="@dimen/text_size_caption"
                            android:textColor="@color/textSecondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Generate QR Button - Outlined Grey -->
<!--                <com.google.android.material.button.MaterialButton-->
<!--                    android:id="@+id/button_generate_qr"-->
<!--                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="@dimen/size_button_height"-->
<!--                    android:layout_marginTop="@dimen/spacing_vertical"-->
<!--                    android:text="Generate QR Code"-->
<!--                    android:textSize="@dimen/text_size_body"-->
<!--                    android:textStyle="bold"-->
<!--                    android:textColor="@color/textPrimary"-->
<!--                    app:strokeColor="@color/light_grey_border"-->
<!--                    app:cornerRadius="@dimen/radius_button" />-->

                <!-- Publish Button - Filled Purple -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_create_event"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_button_height"
                    android:layout_marginTop="@dimen/spacing_vertical"
                    android:layout_marginBottom="24dp"
                    android:text="@string/create_event_button"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    android:textColor="@color/white_background"
                    app:backgroundTint="@color/primary_purple"
                    app:cornerRadius="@dimen/radius_button" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>