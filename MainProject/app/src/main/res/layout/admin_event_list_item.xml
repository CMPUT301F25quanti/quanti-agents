<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/white_background"
    app:strokeColor="@color/light_grey_border"
    app:strokeWidth="@dimen/card_border_width"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="@dimen/card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_card_padding_large"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Title"
                android:textSize="@dimen/text_size_heading"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/item_event_organizer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organizer: John Doe"
                android:textSize="@dimen/text_size_caption"
                android:textColor="@color/textSecondary"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_button_height_medium"
            android:text="Delete"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/error_red"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>