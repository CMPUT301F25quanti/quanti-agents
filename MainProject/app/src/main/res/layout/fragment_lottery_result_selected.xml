<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_background">

    <!-- Green Status Banner - Full Width -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_status_banner_height"
        android:background="@color/success_green"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_card_padding_large"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You were selected!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            android:gravity="center" />
    </LinearLayout>

    <!-- QR Code - Centered -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_qr_code"
        android:layout_width="@dimen/size_qr_code"
        android:layout_height="@dimen/size_qr_code"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/white_background"
        app:strokeColor="@color/light_grey_border"
        app:strokeWidth="@dimen/card_border_width"
        app:cardCornerRadius="@dimen/radius_qr"
        app:cardElevation="@dimen/card_elevation"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_status_banner">

        <ImageView
            android:id="@+id/image_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Event QR Code"
            android:scaleType="fitCenter" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons - Horizontal -->
    <LinearLayout
        android:id="@+id/layout_action_buttons"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_button_height"
        android:layout_marginStart="@dimen/spacing_outer"
        android:layout_marginEnd="@dimen/spacing_outer"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_qr_code">

        <!-- Accept Button - Green -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_accept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Accept"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/success_green"
            app:cornerRadius="@dimen/radius_button" />

        <!-- Decline Button - Red -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_decline"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Decline"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/error_red"
            app:cornerRadius="@dimen/radius_button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

