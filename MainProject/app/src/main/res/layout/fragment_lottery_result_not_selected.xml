<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_background">

    <!-- Red Status Banner - Full Width -->
    <LinearLayout
        android:id="@+id/layout_status_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_status_banner_height"
        android:background="@color/error_red"
        android:gravity="center_vertical"
        android:padding="@dimen/spacing_card_padding_large"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/text_status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You were not selected"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            android:gravity="center" />
    </LinearLayout>

    <!-- Informational Text - Centered -->
    <TextView
        android:id="@+id/text_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_outer"
        android:layout_marginEnd="@dimen/spacing_outer"
        android:layout_marginTop="24dp"
        android:text="You remain on the waiting list and may be selected if spots open up."
        android:textSize="@dimen/text_size_body"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_status_banner" />

    <!-- Back Button - Outlined Grey -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_back"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_button_height"
        android:layout_marginStart="@dimen/spacing_outer"
        android:layout_marginEnd="@dimen/spacing_outer"
        android:layout_marginTop="16dp"
        android:text="Back to Events"
        android:textSize="@dimen/text_size_body"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        app:strokeColor="@color/light_grey_border"
        app:cornerRadius="@dimen/radius_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_info" />

</androidx.constraintlayout.widget.ConstraintLayout>

