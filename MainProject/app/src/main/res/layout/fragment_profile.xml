<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundLightGrey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_outer">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/profile_title"
            android:textSize="@dimen/text_size_title"
            android:textColor="@color/textPrimary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/profile_subtitle"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/textSecondary"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_vertical"
            app:cardBackgroundColor="@color/white_background"
            app:strokeColor="@color/light_grey_border"
            app:cardCornerRadius="@dimen/radius_card"
            app:strokeWidth="@dimen/card_border_width"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_card_padding_large">

                <!--TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:text="@string/profile_info_header"
                    android:textColor="@color/colorOnSurfaceVariant"
                    android:textStyle="bold">

                </TextView-->

                <!-- First Name Field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="@dimen/spacing_vertical"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/textPrimary"
                    android:paddingVertical="12dp" />

                <!-- Last Name Field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_last_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="@dimen/spacing_vertical"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/textPrimary"
                    android:paddingVertical="12dp" />

                <!-- Email Field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="@dimen/spacing_vertical"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/textPrimary"
                    android:paddingVertical="12dp" />

                <!-- Phone Field -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phone"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/textSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="@color/textPrimary"
                    android:paddingVertical="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Edit Profile Button - Primary Purple -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_height"
            android:layout_marginBottom="@dimen/spacing_vertical"
            android:text="@string/profile_edit_action"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/white_background"
            app:backgroundTint="@color/primary_purple"
            app:cornerRadius="@dimen/radius_button" />

        <!-- Delete Profile Button - Outlined Red -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_profile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_button_height"
            android:text="@string/settings_delete_action"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            android:textColor="@color/error_red"
            app:strokeColor="@color/error_red"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>

</ScrollView>
